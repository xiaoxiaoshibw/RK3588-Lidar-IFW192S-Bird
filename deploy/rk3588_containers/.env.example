# Copy to `.env` on RK3588 before running `docker compose up -d`.
# On offline RK3588 boards, set both BASE_IMAGE values to the existing `slam-localization` image
# (auto-detected by `deploy_to_rk3588.py`).

# --- Base images ---
HUMAN_FALL_BASE_IMAGE=ros:noetic-ros-base
BIRD_BASE_IMAGE=ubuntu:20.04

# --- Shared ROS1 / Foxglove endpoints (provided by untouched slam-localization container) ---
ROS_MASTER_URI=http://127.0.0.1:11311
ROS_IP=127.0.0.1
BIRD_FOXGLOVE_URL=ws://127.0.0.1:8765
BIRD_INPUT_TOPIC=/innolidar_points

# --- Container 1: lidar-human-fall ---
HUMAN_FALL_BUNDLE_HOST_DIR=/home/wel/.local/opt/lidar-rk3588/bundles/human_fall
HUMAN_FALL_CPUSET=4,5
HUMAN_FALL_MEM_LIMIT=1536m
HUMAN_FALL_MODE=instant_start
HUMAN_FALL_MOUNT_PITCH_DEG=26.0
HUMAN_FALL_MOUNT_ROLL_DEG=0.0
HUMAN_FALL_DISABLE_IMU=1
HUMAN_FALL_PHYSICAL_V1=0
HUMAN_FALL_SINGLE_PERSON_LOCK=0
HUMAN_FALL_DIAGNOSTICS=0

# --- Container 2: lidar-bird ---
BIRD_CALIBRATION_HOST_DIR=/home/wel/.local/opt/lidar-rk3588/calibration
BIRD_CPUSET=6,7
BIRD_MEM_LIMIT=512m
BIRD_HTTP_HOST=0.0.0.0
BIRD_HTTP_PORT=8895
BIRD_AZIMUTH_CSV=/config/calibration/ifw192s_azimuth_192x256.csv
BIRD_ELEVATION_CSV=/config/calibration/ifw192s_elevation_192x256.csv
# Optional: set BIRD_CALIBRATION=/config/calibration/calibration_sdk_geometry.bin to load binary calibration instead of CSV.
BIRD_CALIBRATION=
